<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own surface: the same white card the app lays on its cream
     page, cut to rounded corners with a warm hairline round the edge — so
     the home screen furniture matches the furniture inside. Shape drawables
     are the one background RemoteViews paints without a Bitmap. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#1A3A2E22" />
    <corners android:radius="18dp" />
</shape>
