<?xml version="1.0" encoding="utf-8"?>
<!-- The lock-screen card's face: the next prayer, and the whole day's six
     times — and nothing else. No city, no date: a locked phone gets prayer
     times, not context.
     The height is the design constraint, not the width: Android clips a
     collapsed notification's custom view at roughly 64dp, which ate the
     third row of a three-row card whole. So the six times ride in two
     rows of three, the hairline is gone, and the furniture stays the
     widget's — white card, copper headline. Every text id here is filled
     by LockScreenNotifier.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="9dp"
    android:paddingTop="6dp"
    android:paddingEnd="9dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lock_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textColor="#C97F52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lock_next_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="—"
            android:textColor="#40352C"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lock_time_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text=""
            android:textColor="#40352C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/lock_time_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text=""
            android:textColor="#40352C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/lock_time_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text=""
            android:textColor="#40352C"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lock_time_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text=""
            android:textColor="#40352C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/lock_time_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text=""
            android:textColor="#40352C"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/lock_time_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text=""
            android:textColor="#40352C"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
