<?xml version="1.0" encoding="utf-8"?>
<!-- The minaret icon for Android 7.x, which has no adaptive icons. See
     ic_launcher_crescent.xml for why this is a layer-list by hand. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background_minaret" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_minaret_fg"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"
        android:left="10dp" />
</layer-list>
