# Agent / editor leftovers (app ka hissa nahi)
/.kilo/
web/icons/*.backup

# .env TRACKED hai par sirf placeholder (khali GEMINI_API_KEY) - asli key
# repo me NAHI hai. pubspec.yaml isse asset ki tarah bundle karta hai, isliye
# file ko maujood hona zaroori hai; khali key par app seedha on-device ML Kit
# OCR par chalti hai (gemini_ocr_service.dart wahi fallback hai).
#
# Asli key laptop par .env me rakhi hai (git update-index --skip-worktree .env
# se ignore hoti hai) aur .env.local me backup hai. NOTE: pata chhupane se key
# APK ke andar se nikalna band nahi hoti - wo aaj bhi unzip se nikli ja sakti
# hai. Isliye public build me key daali hi nahi jaati.

