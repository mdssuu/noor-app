# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/
*.iml
.idea/
.vscode/

# Android
android/.gradle/
android/local.properties
android/app/.cxx/
android/gradle/
*.keystore
*.jks
# NOTE: android/key.properties is deliberately NOT ignored (only a stray
# key.properties in the repo root is). The release signing key has to be the
# same on the laptop and on CI - a per-runner debug key means every new APK
# refuses to install over the previous one ("signatures do not match").
/key.properties

# iOS / macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
macos/Pods/

# Platform generated
**/GeneratedPluginRegistrant.*

# Misc
*.log
.DS_Store
Thumbs.db

# NOTE: .env is intentionally committed. pubspec.yaml bundles it as an asset,
# so without it in the repo every GitHub / Codespace build produces an app with
# no GEMINI_API_KEY and silently falls back to on-device OCR. The key ships
# inside the APK either way (see gemini_ocr_service.dart), so keeping it out of
# git bought nothing and broke every off-laptop build.
