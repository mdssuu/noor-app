# PLACEHOLDER - is repo me koi key nahi hai.
#
# Asli GEMINI_API_KEY public repo me nahi rakhi jaati: flutter_dotenv ise
# asset ki tarah APK ke andar bundle karta hai, yaani APK download karke koi
# bhi key nikal leta. Khali key par app seedha on-device ML Kit OCR par
# chalti hai - wahi default raasta hai.
#
# Apni asli key sirf apne laptop par rakho: yahin .env me (git ise
# skip-worktree se ignore karta hai) ya backup ke roop me .env.local me.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
