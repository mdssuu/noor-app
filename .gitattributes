# Default: har file ko text maano aur OS ke hisaab se line endings normalise karo.
* text=auto

# Linux ke liye zaroori: shell scripts aur CI workflows me CRLF aaya to
# "bash: /usr/bin/env: 'bash\r': No such file or directory" jaisi error aati hai
# aur Codespace ka postCreate command fail ho jaata hai.
*.sh    text eol=lf
*.bash  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.dart  text eol=lf
*.md    text eol=lf
*.kt    text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.kts   text eol=lf

# Windows-only files CRLF hi rakho.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets - bilkul mat chhuo.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.mp3   binary
*.wav   binary
*.jar   binary
